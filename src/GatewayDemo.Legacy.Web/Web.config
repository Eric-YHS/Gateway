<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Gateway.AppName" value="统一认证访问网关" />
    <add key="Gateway.ProxyBasePath" value="/proxy" />
    <add key="Gateway.DeviceCookieName" value="gw_device_credential" />
    <add key="Gateway.DeviceCookieDomain" value="" />
    <add key="Gateway.DeviceCookieSameSite" value="" />
    <add key="Gateway.DeviceCookieSecurePolicy" value="Never" />
    <add key="Gateway.ExternalScheme" value="" />
    <add key="Gateway.UseDefaultUpstreamProxy" value="true" />
    <add key="Gateway.UpstreamProxyUrl" value="" />
    <add key="Gateway.TrustedProxyAddresses" value="" />
    <add key="Gateway.TrustedProxyCidrs" value="" />
    <add key="Gateway.BrowserDevice.ReviewOnSignalChange" value="True" />
    <add key="Gateway.BrowserDevice.SignalHeaders" value="User-Agent,Sec-CH-UA-Platform,Sec-CH-UA-Mobile" />
    <add key="Gateway.LegacyApp.AllowAccountOnlyIdentityFallback" value="false" />
    <add key="Gateway.Cors.Enabled" value="false" />
    <add key="Gateway.Cors.AllowedOrigins" value="" />
    <add key="Gateway.Cors.AllowedMethods" value="GET,POST,PUT,PATCH,DELETE,OPTIONS" />
    <add key="Gateway.Cors.AllowedHeaders" value="Content-Type,Authorization,X-Requested-With" />
    <add key="Gateway.Cors.AllowCredentials" value="true" />
    <add key="Gateway.Cors.MaxAgeSeconds" value="600" />
    <add key="Gateway.SitesConfigPath" value="App_Data/gateway-sites.json" />
    <add key="Storage.SqlitePath" value="App_Data/gateway-demo-legacy.db" />
    <add key="Admin.Username" value="gateway-admin" />
    <add key="Admin.PasswordHash" value="pbkdf2-sha256$210000$TL7JM2T+YE/7sa2qZ/VhZw==$yCVnMUrTTYXXMo+y0cO9mQAc5kDU6IGM3rGJIWlNv/I=" />
    <add key="Admin.ManagementPort" value="29051" />
    <add key="Admin.LoginPermitLimit" value="5" />
    <add key="Admin.LoginWindowMinutes" value="5" />
    <add key="Gateway.AppDiagnostics.Enabled" value="false" />
  </appSettings>
  <system.web>
    <authentication mode="Forms">
      <forms name="gw_admin_session" loginUrl="~/Admin/Default.aspx" timeout="480" slidingExpiration="true" protection="All" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="zh-CN" uiCulture="zh-CN" />
    <customErrors mode="On" defaultRedirect="~/Gateway/Default.aspx" />
    <compilation debug="false" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" requestValidationMode="4.5" requestPathInvalidCharacters="&lt;,&gt;,*,%,&amp;,\,?" executionTimeout="3600" maxUrlLength="65534" maxQueryStringLength="65534" maxRequestLength="1048576" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
    <httpModules>
      <add name="ProxyRequestModule" type="GatewayDemo.Legacy.Web.Infrastructure.ProxyRequestModule, GatewayDemo.Legacy.Web" />
    </httpModules>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxUrl="65534" maxQueryString="65534" maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
    <webSocket enabled="true" />
    <defaultDocument enabled="true">
      <files>
        <add value="Gateway/Default.aspx" />
      </files>
    </defaultDocument>
    <handlers>
      <add name="HealthzHandler" path="healthz.ashx" verb="GET,HEAD" type="GatewayDemo.Legacy.Web.Handlers.Healthz, GatewayDemo.Legacy.Web" resourceType="Unspecified" />
    </handlers>
    <modules runAllManagedModulesForAllRequests="true">
      <add name="ProxyRequestModule" type="GatewayDemo.Legacy.Web.Infrastructure.ProxyRequestModule, GatewayDemo.Legacy.Web" />
    </modules>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="400" subStatusCode="-1" />
      <error statusCode="400" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="403" subStatusCode="-1" />
      <error statusCode="403" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="404" subStatusCode="8" />
      <error statusCode="404" subStatusCode="8" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="405" subStatusCode="-1" />
      <error statusCode="405" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="406" subStatusCode="-1" />
      <error statusCode="406" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="414" subStatusCode="-1" />
      <error statusCode="414" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500" subStatusCode="-1" path="/Gateway/errors/blocked.html" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
